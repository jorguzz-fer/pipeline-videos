# --- Banco (PostgreSQL) ---
# Em dev com docker-compose, o serviço "db" expõe na porta 5432.
DATABASE_URL="postgresql://pipeline:pipeline@localhost:5432/pipeline?schema=public"

# --- Auth (NextAuth / Auth.js) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-um-segredo-aleatorio"
# URL pública da aplicação (em dev pode omitir; em prod defina o domínio)
# AUTH_URL="https://aprovacao.tudomudou.com"

# --- API de serviço (n8n / HeyGen / WhatsApp chamam a camada de saída) ---
# Chave usada no header `x-api-key` pelos workflows do n8n.
SERVICE_API_KEY="troque-isto-por-uma-chave-de-servico"

# --- Webhook de saída (a camada notifica o n8n a cada transição de estágio) ---
# URL do Webhook do workflow "02 — Esteira de eventos" no n8n.
# Deixe vazio para desligar a emissão de eventos.
OUTBOUND_WEBHOOK_URL=""
# Segredo p/ assinar o corpo (header x-signature: sha256=...). Opcional.
OUTBOUND_WEBHOOK_SECRET=""

# --- Seed (usuário owner inicial) ---
SEED_OWNER_EMAIL="fer.jorge@gmail.com"
SEED_OWNER_PASSWORD="mudar123"
