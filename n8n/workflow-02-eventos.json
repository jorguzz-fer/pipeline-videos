{
  "name": "02 — Esteira de Eventos Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pipeline-eventos",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "n02-wh-eventos",
      "name": "Webhook Eventos Pipeline",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "pipeline-eventos-wh"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg01",
              "name": "WHATSAPP_BASE_URL",
              "value": "https://sua-evolution-api.com",
              "type": "string"
            },
            {
              "id": "cfg02",
              "name": "WHATSAPP_INSTANCE",
              "value": "sua-instancia",
              "type": "string"
            },
            {
              "id": "cfg03",
              "name": "CLIENT_PHONE",
              "value": "5511999999999",
              "type": "string"
            },
            {
              "id": "cfg04",
              "name": "PIPELINE_BASE_URL",
              "value": "https://pipeline.tudomudou.com.br",
              "type": "string"
            },
            {
              "id": "cfg05",
              "name": "WEBHOOK_SECRET",
              "value": "COLE_SEU_OUTBOUND_WEBHOOK_SECRET_AQUI_ou_deixe_vazio",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n02-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300],
      "_instrucoes": "EDITE ESTE NO apos importar. A URL do webhook deste workflow deve ser colada em OUTBOUND_WEBHOOK_URL no Coolify."
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst secret = $('Config').first().json.WEBHOOK_SECRET ?? '';\nconst sig = item.json.headers?.['x-signature'] ?? '';\n\nif (secret && secret !== 'COLE_SEU_OUTBOUND_WEBHOOK_SECRET_AQUI_ou_deixe_vazio' && sig) {\n  const crypto = require('crypto');\n  const body = JSON.stringify(item.json.body);\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(body).digest('hex');\n  if (sig !== expected) {\n    throw new Error('Assinatura invalida');\n  }\n}\n\nreturn $input.all();"
      },
      "id": "n02-code-verify",
      "name": "Verifica Assinatura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e01", "name": "event", "value": "={{ $json.body.event }}", "type": "string" },
            { "id": "e02", "name": "itemId", "value": "={{ $json.body.item.id }}", "type": "string" },
            { "id": "e03", "name": "itemTitle", "value": "={{ $json.body.item.title }}", "type": "string" },
            { "id": "e04", "name": "itemStage", "value": "={{ $json.body.item.stage }}", "type": "string" },
            { "id": "e05", "name": "videoUrl", "value": "={{ $json.body.item.videoUrl ?? '' }}", "type": "string" },
            { "id": "e06", "name": "scheduledFor", "value": "={{ $json.body.item.scheduledFor ?? '' }}", "type": "string" },
            { "id": "e07", "name": "clientPhone", "value": "={{ $json.body.item.client?.phone ?? $('Config').item.json.CLIENT_PHONE }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "n02-set-event",
      "name": "Set Extrai Evento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "s01", "leftValue": "={{ $json.event }}", "rightValue": "item.final_approved", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "final_approved"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "s02", "leftValue": "={{ $json.event }}", "rightValue": "item.changes_requested", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "changes_requested"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "s03", "leftValue": "={{ $json.event }}", "rightValue": "item.scheduled", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "scheduled"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
                "conditions": [{ "id": "s04", "leftValue": "={{ $json.event }}", "rightValue": "item.published", "operator": { "type": "string", "operation": "equals" } }],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "published"
            }
          ]
        },
        "options": {}
      },
      "id": "n02-switch-event",
      "name": "Switch Tipo Evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.clientPhone, text: '✅ *Video APROVADO!*\\n\\n📌 *' + $json.itemTitle + '*\\n\\nParabens! Seu video foi aprovado e sera agendado para publicacao em breve.\\n\\n_Tudo Mudou | Producao de Conteudo_' }) }}",
        "options": {}
      },
      "id": "n02-wa-aprovado",
      "name": "WA Aprovacao Final",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 60],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-whatsapp",
          "name": "WhatsApp Evolution API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.clientPhone, text: '🔄 *Ajuste solicitado — recebemos!*\\n\\n📌 *' + $json.itemTitle + '*\\n\\nSua solicitacao de ajuste foi registrada. Nossa equipe ira revisar e enviar uma nova versao em breve.\\n\\n_Tudo Mudou | Producao de Conteudo_' }) }}",
        "options": {}
      },
      "id": "n02-wa-ajuste",
      "name": "WA Ajuste Solicitado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-whatsapp",
          "name": "WhatsApp Evolution API Key"
        }
      }
    },
    {
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ $json.scheduledFor }}"
      },
      "id": "n02-wait-schedule",
      "name": "Aguarda Agendamento",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [1640, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.PIPELINE_BASE_URL}/api/items/${$json.itemId}/publish` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ publishedAt: new Date().toISOString(), actorName: 'n8n — Publicacao Automatica' }) }}",
        "options": {}
      },
      "id": "n02-http-publish",
      "name": "Pipeline Publica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 380],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-pipeline",
          "name": "Pipeline API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Set Extrai Evento').item.json.clientPhone, text: '🚀 *Video PUBLICADO com sucesso!*\\n\\n📌 *' + $('Set Extrai Evento').item.json.itemTitle + '*\\n\\nSeu conteudo ja esta no ar! 🎉\\n\\n_Tudo Mudou | Producao de Conteudo_' }) }}",
        "options": {}
      },
      "id": "n02-wa-publicado-agendado",
      "name": "WA Publicado Agendado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 380],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-whatsapp",
          "name": "WhatsApp Evolution API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.clientPhone, text: '🚀 *Video PUBLICADO!*\\n\\n📌 *' + $json.itemTitle + '*\\n\\nSeu conteudo ja esta no ar! 🎉\\n\\n_Tudo Mudou | Producao de Conteudo_' }) }}",
        "options": {}
      },
      "id": "n02-wa-publicado-direto",
      "name": "WA Publicado Direto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 540],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-whatsapp",
          "name": "WhatsApp Evolution API Key"
        }
      }
    }
  ],
  "connections": {
    "Webhook Eventos Pipeline": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Verifica Assinatura", "type": "main", "index": 0 }]]
    },
    "Verifica Assinatura": {
      "main": [[{ "node": "Set Extrai Evento", "type": "main", "index": 0 }]]
    },
    "Set Extrai Evento": {
      "main": [[{ "node": "Switch Tipo Evento", "type": "main", "index": 0 }]]
    },
    "Switch Tipo Evento": {
      "main": [
        [{ "node": "WA Aprovacao Final", "type": "main", "index": 0 }],
        [{ "node": "WA Ajuste Solicitado", "type": "main", "index": 0 }],
        [{ "node": "Aguarda Agendamento", "type": "main", "index": 0 }],
        [{ "node": "WA Publicado Direto", "type": "main", "index": 0 }]
      ]
    },
    "Aguarda Agendamento": {
      "main": [[{ "node": "Pipeline Publica", "type": "main", "index": 0 }]]
    },
    "Pipeline Publica": {
      "main": [[{ "node": "WA Publicado Agendado", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
