    },
    "Aguarda 5min": {
      "main": [[{ "node": "HeyGen Verifica Status", "type": "main", "index": 0 }]]
    },
    "HeyGen Verifica Status": {
      "main": [[{ "node": "Video Pronto", "type": "main", "index": 0 }]]
    },
    "Video Pronto": {
      "main": [
        [{ "node": "Pipeline Video Pronto", "type": "main", "index": 0 }],
        [{ "node": "Aguarda 5min", "type": "main", "index": 0 }]
      ]
    },
    "Pipeline Video Pronto": {
      "main": [[{ "node": "WA Notifica Aprovacao", "type": "main", "index": 0 }]]
    },
    "WA Notifica Aprovacao": {
