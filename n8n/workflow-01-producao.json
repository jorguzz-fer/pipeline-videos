{
  "name": "01 — Esteira de Producao GrowthMinds",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "intake-growthminds",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "n01-wh-intake",
      "name": "Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "intake-growthminds-wh"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg01",
              "name": "HEYGEN_AVATAR_ID",
              "value": "COLE_SEU_AVATAR_ID_AQUI",
              "type": "string"
            },
            {
              "id": "cfg02",
              "name": "HEYGEN_VOICE_ID",
              "value": "COLE_SEU_VOICE_ID_AQUI",
              "type": "string"
            },
            {
              "id": "cfg03",
              "name": "WHATSAPP_BASE_URL",
              "value": "https://sua-evolution-api.com",
              "type": "string"
            },
            {
              "id": "cfg04",
              "name": "WHATSAPP_INSTANCE",
              "value": "sua-instancia",
              "type": "string"
            },
            {
              "id": "cfg05",
              "name": "CLIENT_PHONE",
              "value": "5511999999999",
              "type": "string"
            },
            {
              "id": "cfg06",
              "name": "PIPELINE_BASE_URL",
              "value": "https://pipeline.tudomudou.com.br",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n01-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300],
      "_instrucoes": "EDITE ESTE NO apos importar. Coloque seus valores reais aqui. As chaves de API ficam nas Credentials do n8n (ver README)."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a01",
              "name": "title",
              "value": "={{ $('Webhook Intake').item.json.body.title ?? $('Webhook Intake').item.json.body.assunto ?? ('Video ' + $now.toFormat('yyyy-MM-dd')) }}",
              "type": "string"
            },
            {
              "id": "a02",
              "name": "clientName",
              "value": "GrowthMinds — Dr. Kleber",
              "type": "string"
            },
            {
              "id": "a03",
              "name": "clientContactName",
              "value": "Dr. Kleber",
              "type": "string"
            },
            {
              "id": "a04",
              "name": "networks",
              "value": "={{ $('Webhook Intake').item.json.body.networks ?? ['INSTAGRAM', 'YOUTUBE'] }}",
              "type": "array"
            },
            {
              "id": "a05",
              "name": "source",
              "value": "HEYGEN",
              "type": "string"
            },
            {
              "id": "a06",
              "name": "briefing",
              "value": "={{ $('Webhook Intake').item.json.body.briefing ?? $('Webhook Intake').item.json.body.descricao ?? $('Webhook Intake').item.json.body.tema ?? '' }}",
              "type": "string"
            },
            {
              "id": "a07",
              "name": "externalRef",
              "value": "={{ $('Webhook Intake').item.json.body.externalRef ?? $('Webhook Intake').item.json.body.id ?? '' }}",
              "type": "string"
            },
            {
              "id": "a08",
              "name": "heygenAvatarId",
              "value": "={{ $('Webhook Intake').item.json.body.heygenAvatarId ?? $('Config').item.json.HEYGEN_AVATAR_ID }}",
              "type": "string"
            },
            {
              "id": "a09",
              "name": "heygenVoiceId",
              "value": "={{ $('Webhook Intake').item.json.body.heygenVoiceId ?? $('Config').item.json.HEYGEN_VOICE_ID }}",
              "type": "string"
            },
            {
              "id": "a10",
              "name": "clientPhone",
              "value": "={{ $('Webhook Intake').item.json.body.clientPhone ?? $('Config').item.json.CLIENT_PHONE }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n01-set-normalize",
      "name": "Set Normaliza",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.PIPELINE_BASE_URL }}/api/items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, clientName: $json.clientName, clientContactName: $json.clientContactName, source: $json.source, networks: $json.networks, externalRef: $json.externalRef }) }}",
        "options": {}
      },
      "id": "n01-http-create",
      "name": "Pipeline Cria Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-pipeline",
          "name": "Pipeline API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "b01", "name": "itemId", "value": "={{ $json.id }}", "type": "string" },
            { "id": "b02", "name": "itemTitle", "value": "={{ $json.title }}", "type": "string" },
            { "id": "b03", "name": "briefing", "value": "={{ $('Set Normaliza').item.json.briefing }}", "type": "string" },
            { "id": "b04", "name": "heygenAvatarId", "value": "={{ $('Set Normaliza').item.json.heygenAvatarId }}", "type": "string" },
            { "id": "b05", "name": "heygenVoiceId", "value": "={{ $('Set Normaliza').item.json.heygenVoiceId }}", "type": "string" },
            { "id": "b06", "name": "clientPhone", "value": "={{ $('Set Normaliza').item.json.clientPhone }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "n01-set-itemid",
      "name": "Set Item ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-4-7', max_tokens: 2000, messages: [{ role: 'user', content: 'Voce e um roteirista especialista em conteudo medico educativo para o Dr. Kleber Melo (GrowthMinds). Crie um roteiro para video curto (60-90 segundos) sobre o tema: \"' + $json.briefing + '\"\\n\\nTitulo: \"' + $json.itemTitle + '\"\\n\\nRegras:\\n- Linguagem acessivel ao publico leigo\\n- Medicina baseada em evidencias\\n- Estrutura: GANCHO (5s impactante) > DESENVOLVIMENTO (50-70s com dica pratica) > CTA (10s para seguir o perfil)\\n- Tom: didatico, confiante e humanizado\\n\\nRetorne APENAS o roteiro corrido, sem titulos de secao.' }] }) }}",
        "options": {}
      },
      "id": "n01-http-claude",
      "name": "Claude Gera Roteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-anthropic",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "c01", "name": "itemId", "value": "={{ $('Set Item ID').item.json.itemId }}", "type": "string" },
            { "id": "c02", "name": "itemTitle", "value": "={{ $('Set Item ID').item.json.itemTitle }}", "type": "string" },
            { "id": "c03", "name": "script", "value": "={{ $json.content[0].text }}", "type": "string" },
            { "id": "c04", "name": "heygenAvatarId", "value": "={{ $('Set Item ID').item.json.heygenAvatarId }}", "type": "string" },
            { "id": "c05", "name": "heygenVoiceId", "value": "={{ $('Set Item ID').item.json.heygenVoiceId }}", "type": "string" },
            { "id": "c06", "name": "clientPhone", "value": "={{ $('Set Item ID').item.json.clientPhone }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "n01-set-script",
      "name": "Set Extrai Roteiro",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1920, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ `${$('Config').item.json.PIPELINE_BASE_URL}/api/items/${$json.itemId}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ script: $json.script }) }}",
        "options": {}
      },
      "id": "n01-http-save-script",
      "name": "Pipeline Salva Roteiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-pipeline",
          "name": "Pipeline API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ video_inputs: [{ character: { type: 'avatar', avatar_id: $('Set Extrai Roteiro').item.json.heygenAvatarId, avatar_style: 'normal' }, voice: { type: 'text', voice_id: $('Set Extrai Roteiro').item.json.heygenVoiceId, input_text: $('Set Extrai Roteiro').item.json.script, speed: 1.0 }, background: { type: 'color', value: '#1a1a2e' } }], aspect_ratio: '9:16', test: false }) }}",
        "options": {}
      },
      "id": "n01-http-heygen",
      "name": "HeyGen Submete Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-heygen",
          "name": "HeyGen API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "d01", "name": "itemId", "value": "={{ $('Set Extrai Roteiro').item.json.itemId }}", "type": "string" },
            { "id": "d02", "name": "itemTitle", "value": "={{ $('Set Extrai Roteiro').item.json.itemTitle }}", "type": "string" },
            { "id": "d03", "name": "heygenVideoId", "value": "={{ $json.data.video_id }}", "type": "string" },
            { "id": "d04", "name": "clientPhone", "value": "={{ $('Set Extrai Roteiro').item.json.clientPhone }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "n01-set-heygenid",
      "name": "Set HeyGen ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2760, 300]
    },
    {
      "parameters": {
        "unit": "minutes",
        "value": 5
      },
      "id": "n01-wait-5min",
      "name": "Aguarda 5min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [3040, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ `https://api.heygen.com/v1/video_status.get?video_id=${$('Set HeyGen ID').item.json.heygenVideoId}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "n01-http-heygen-status",
      "name": "HeyGen Verifica Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3320, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-heygen",
          "name": "HeyGen API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond01",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "completed",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n01-if-ready",
      "name": "Video Pronto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3600, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ `${$('Config').item.json.PIPELINE_BASE_URL}/api/items/${$('Set HeyGen ID').item.json.itemId}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoUrl: $json.data.video_url, previewUrl: $json.data.thumbnail_url, durationSeconds: Math.round($json.data.duration ?? 60), markReadyForFinal: true }) }}",
        "options": {}
      },
      "id": "n01-http-video-pronto",
      "name": "Pipeline Video Pronto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3880, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-pipeline",
          "name": "Pipeline API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Set HeyGen ID').item.json.clientPhone, text: '🎬 *Seu video esta pronto para aprovacao!*\\n\\n📌 *' + $('Set HeyGen ID').item.json.itemTitle + '*\\n\\nAssista ao preview e aprove ou solicite ajustes:\\n\\n👉 https://pipeline.tudomudou.com.br\\n\\n_Tudo Mudou | Producao de Conteudo_' }) }}",
        "options": {}
      },
      "id": "n01-http-wa-notifica",
      "name": "WA Notifica Aprovacao",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4160, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-whatsapp",
          "name": "WhatsApp Evolution API Key"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, itemId: $('Set HeyGen ID').item.json.itemId }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "n01-respond",
      "name": "Responde Intake",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [4440, 180]
    }
  ],
  "connections": {
