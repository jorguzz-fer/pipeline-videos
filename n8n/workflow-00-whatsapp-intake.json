      "id": "n00-if-kleber",
      "name": "IF E o Dr. Kleber",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1360, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-4-7', max_tokens: 500, messages: [{ role: 'user', content: 'Voce e um assistente que interpreta pedidos de video do Dr. Kleber Melo (GrowthMinds) recebidos via WhatsApp e os converte em JSON estruturado.\\n\\nMensagem recebida:\\n\"' + $json.messageText + '\"\\n\\nAnalise a mensagem e retorne APENAS um JSON valido (sem markdown, sem explicacoes) no formato:\\n{\\n  \"valido\": true/false,\\n  \"title\": \"titulo curto do video (max 80 chars)\",\\n  \"briefing\": \"descricao detalhada do tema para o roteirista\",\\n  \"networks\": [\"INSTAGRAM\", \"YOUTUBE\"],\\n  \"infoFaltando\": \"descreva o que falta se valido=false, senao string vazia\"\\n}\\n\\nSe a mensagem nao tiver informacao suficiente para criar um video (ex: mensagem de saudacao, pedido muito vago sem tema), defina valido=false e descreva o que falta em infoFaltando.' }] }) }}",
        "options": {}
      },
      "id": "n00-claude-interpreta",
      "name": "Claude Interpreta Pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 180],
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-anthropic",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst raw = item.json.content[0].text.trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // fallback se Claude retornou markdown com ```json\n  const match = raw.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  parsed = match ? JSON.parse(match[1].trim()) : { valido: false, infoFaltando: 'Erro ao interpretar resposta da IA' };\n}\n\nreturn [{ json: {\n  valido: parsed.valido ?? false,\n  title: parsed.title ?? '',\n  briefing: parsed.briefing ?? '',\n  networks: parsed.networks ?? ['INSTAGRAM', 'YOUTUBE'],\n  infoFaltando: parsed.infoFaltando ?? '',\n  senderPhone: $('Set Extrai Dados WA').item.json.senderPhone,\n  senderName: $('Set Extrai Dados WA').item.json.senderName,\n  messageText: $('Set Extrai Dados WA').item.json.messageText\n}}];"
      },
      "id": "n00-code-parse",
      "name": "Code Parse JSON Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c05",
              "leftValue": "={{ $json.valido }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n00-if-valido",
      "name": "IF Pedido Valido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2200, 180]
