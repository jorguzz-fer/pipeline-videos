        "method": "POST",
        "url": "={{ `${$('Config').item.json.WHATSAPP_BASE_URL}/message/sendText/${$('Config').item.json.WHATSAPP_INSTANCE}` }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Code Parse JSON Claude').item.json.senderPhone, text: '✅ *Pedido recebido, Dr. Kleber!*\\n\\n📌 *' + $('Code Parse JSON Claude').item.json.title + '*\\n\\nJa estou gerando o roteiro com a IA e logo em seguida o video no HeyGen.\\n\\nVoce sera notificado assim que estiver pronto para aprovacao. ⏱️' }) }}",
        "options": {}
      },
      "id": "n00-wa-confirma",
