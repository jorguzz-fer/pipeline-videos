    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.PIPELINE_INTAKE_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, briefing: $json.briefing, networks: $json.networks, clientName: 'GrowthMinds — Dr. Kleber', clientContactName: 'Dr. Kleber', source: 'HEYGEN', clientPhone: $json.senderPhone, externalRef: 'wa-' + Date.now() }) }}",
        "options": {}
      },
      "id": "n00-http-intake",
      "name": "HTTP Dispara Workflow 01",
